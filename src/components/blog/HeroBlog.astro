---

<section
  class="w-full flex flex-col justify-center gap-12 pt-12 pb-12 lg:pt-32 lg:pb-32"
>
  <div class="w-full gap-12 items-center">
    <div
      class="col-span-1 max-w-3xl flex flex-col justify-center items-center gap-8 mx-auto"
    >
      <h1 class="text-4xl lg:text-6xl font-bold text-center" data-hero-title style="clip-path: inset(0 0 100% 0); transform: translateY(100%);">
        Blog Santé Dentaire
      </h1>
      <p class="text-primary/80 text-base font-sans text-center" data-hero-text style="clip-path: inset(0 0 100% 0); transform: translateY(100%);">
        Conseils, innovations et astuces pour prendre soin de votre santé
        bucco-dentaire au quotidien.
      </p>

      {/* Champ de recherche */}
      <div class="w-full max-w-2xl mt-4" data-hero-cta style="opacity: 0;">
        <div class="relative">
          <input
            type="text"
            id="search-input"
            placeholder="Rechercher un article..."
            class="w-full px-6 py-4 pr-12 rounded-full border-2 border-[#e9eaeb] bg-white text-[#3c3c3c] placeholder:text-[#6f6f6f] focus:outline-none focus:border-primary transition-colors duration-200"
          />
          <svg
            class="absolute right-5 top-1/2 -translate-y-1/2 w-5 h-5 text-[#6f6f6f]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
