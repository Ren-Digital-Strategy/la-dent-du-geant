  {
    rating: 5,
    text: "J'ai été très satisfait de mes soins. L'équipe est très professionnelle et attentive.",
    author: "John Doe",
    image: avatar,
  },
  {
    rating: 5,
    text: "J'ai été très satisfait de mes soins. L'équipe est très professionnelle et attentive.",
    author: "John Doe",
    image: avatar,
