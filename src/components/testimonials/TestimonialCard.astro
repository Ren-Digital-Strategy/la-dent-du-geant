---
import { Star } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  rating: number;
  text: string;
  author: string;
  image: ImageMetadata | string;
}

const { rating, text, author, image } = Astro.props;

// Détermine si l'image est une URL externe ou un asset local
const isExternalImage = typeof image === "string";
---

<div
  class="testimonial-card bg-white rounded-3xl p-8 flex flex-col gap-3 min-w-[200px] md:min-w-[250px] lg:min-w-[280px]"
>
  <div class="flex items-center gap-2">
    {
      Array.from({ length: rating }).map((_, index) => (
        <Star
          fill="#AD8566"
          stroke="#AD8566"
          stroke-width="0.5"
          class="w-4 h-4"
        />
      ))
    }
  </div>
  <p class="text-primary/80 text-base font-sans line-clamp-4">{text}</p>
  <div class="flex items-center gap-2">
    {
      isExternalImage ? (
        <img
          src={image}
          alt={author}
          width={40}
          height={40}
          class="w-10 h-10 rounded-full object-cover"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      ) : (
        <Image
          src={image}
          alt={author}
          width={40}
          height={40}
          class="w-10 h-10 rounded-full object-cover"
        />
      )
    }
    <p class="text-primary/80 text-base font-sans">{author}</p>
  </div>
</div>
