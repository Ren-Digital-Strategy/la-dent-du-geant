---
import { Star } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  rating: number;
  text: string;
  author: string;
  image: ImageMetadata;
}
const { rating, text, author, image } = Astro.props;
---

<div
  class="testimonial-card bg-white rounded-3xl p-8 flex flex-col gap-3 min-w-[200px] md:min-w-[250px] lg:min-w-[280px]"
>
  <div class="flex items-center gap-2">
    {
      Array.from({ length: rating }).map((_, index) => (
        <Star
          fill="#AD8566"
          stroke="#AD8566"
          stroke-width="0.5"
          class="w-4 h-4"
        />
      ))
    }
  </div>
  <p class="text-primary/80 text-base font-sans">{text}</p>
  <div class="flex items-center gap-2">
    <Image
      src={image}
      alt={author}
      width={1000}
      height={1000}
      class="w-10 h-10 rounded-full"
    />
    <p class="text-primary/80 text-base font-sans">{author}</p>
  </div>
</div>
