---
interface FullDescription {
  diplome?: string;
  formations?: string[];
  interets?: string;
  role?: string;
}

interface Props {
  name: string;
  role: string;
  description: string;
  fullDescription?: FullDescription;
  image: string;
  isFounder?: boolean;
}

const { name, role, description, fullDescription, image, isFounder = false } = Astro.props;
const hasFullDescription = fullDescription && Object.keys(fullDescription).length > 0;
const cardId = `card-dentist-${name.replace(/\s+/g, '-').toLowerCase()}`;
---

<!-- Version Mobile -->
<div class="md:hidden relative mt-32 rounded-3xl overflow-visible">
  <!-- Image qui déborde vers le haut -->
  <div
    class="absolute left-1/2 -translate-x-1/2 -top-28 w-[200px] h-[240px] z-20"
  >
    <img
      src={image}
      alt={name}
      class="w-full h-full object-cover object-top rounded-2xl"
    />
  </div>

  <!-- Contenu -->
  <div class="bg-secondary rounded-t-3xl px-5 pt-32 pb-4">
    <h3 class="text-primary font-bold text-lg text-center">{name}</h3>
    <p class="text-quinary text-sm font-sans mt-1 text-center">{role}</p>
  </div>

  <div class="bg-[#DCDFE2] rounded-b-3xl px-5 py-4">
    <p class="text-primary/70 text-sm font-sans leading-relaxed text-center">
      {description}
    </p>

    <div class="flex flex-col items-center gap-2 mt-4">
      {hasFullDescription && (
        <button
          class="text-tertiary text-xs font-semibold flex items-center gap-1 hover:underline open-modal-btn"
          data-modal-target={cardId}
        >
          <span>En savoir plus</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>
      )}

      {isFounder && (
        <div class="text-primary px-4 py-2 rounded-full font-medium flex items-center gap-2 text-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          Mot du fondateur
        </div>
      )}
    </div>
  </div>
</div>

<!-- Version Desktop -->
<div
  class="hidden md:flex flex-col card-container relative rounded-3xl overflow-visible h-full"
>
  <!-- Zone haute: fond beige -->
  <div
    class="bg-transparent rounded-t-3xl pt-6 lg:pt-8 px-6 lg:px-8 pb-4 pl-[230px] lg:pl-[280px] flex-grow"
  >
    <div class="flex flex-col gap-1">
      <h3 class="text-primary font-bold text-xl lg:text-2xl">{name}</h3>
      <p class="text-quinary text-sm lg:text-base font-sans">{role}</p>
    </div>
  </div>

  <!-- Zone basse: fond gris pour description -->
  <div
    class="bg-[#DCDFE2] rounded-3xl px-6 lg:px-8 pb-6 lg:pb-8 pt-4 pl-[230px] lg:pl-[280px]"
  >
    <p class="text-primary/70 text-sm lg:text-base font-sans leading-relaxed">
      {description}
    </p>

    <div class="flex items-center gap-4 mt-4">
      {hasFullDescription && (
        <button
          class="text-tertiary text-sm font-semibold flex items-center gap-1 hover:underline open-modal-btn"
          data-modal-target={cardId}
        >
          <span>En savoir plus</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>
      )}

      {isFounder && (
        <div class="text-primary py-2.5 rounded-full font-medium flex items-center gap-2 text-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          Mot du fondateur
        </div>
      )}
    </div>
  </div>

  <!-- Image positionnée en bas -->
  <div
    class="absolute left-6 lg:left-8 bottom-6 lg:bottom-8 w-[190px] lg:w-[230px] z-20"
  >
    <img
      src={image}
      alt={name}
      class="w-full h-auto object-cover object-top rounded-2xl lg:rounded-3xl"
    />
  </div>
</div>

<!-- Modal avec les détails complets -->
{hasFullDescription && (
  <div
    id={cardId}
    class="modal-overlay fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-[#f8f1e7]/80"
    style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;"
  >
    <div class="modal-content bg-white rounded-3xl max-w-lg w-full max-h-[85vh] overflow-y-auto shadow-[0_25px_50px_-12px_rgba(0,0,0,0.15)] transform scale-95 opacity-0 transition-all duration-300 border border-[#e5ddd7]">
      <!-- Header avec image -->
      <div class="bg-secondary rounded-t-3xl p-6 flex items-center gap-4">
        <img
          src={image}
          alt={name}
          class="w-20 h-20 object-cover object-top rounded-xl"
        />
        <div class="flex-1">
          <h3 class="text-primary font-bold text-xl">{name}</h3>
          <p class="text-quinary text-sm font-sans">{role}</p>
        </div>
        <button class="close-modal-btn p-2 hover:bg-primary/10 rounded-full transition-colors">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Contenu détaillé -->
      <div class="p-6 space-y-5">
        {fullDescription.diplome && (
          <div>
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
              <p class="text-primary font-semibold">Diplôme</p>
            </div>
            <p class="text-primary/70 font-sans text-sm pl-7">{fullDescription.diplome}</p>
          </div>
        )}

        {fullDescription.formations && fullDescription.formations.length > 0 && (
          <div>
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
              <p class="text-primary font-semibold">Formations</p>
            </div>
            <ul class="text-primary/70 font-sans text-sm pl-7 space-y-1">
              {fullDescription.formations.map((formation) => (
                <li class="flex items-start gap-2">
                  <span class="text-tertiary mt-1.5">•</span>
                  <span>{formation}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {fullDescription.interets && (
          <div>
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              <p class="text-primary font-semibold">Centres d'intérêt</p>
            </div>
            <p class="text-primary/70 font-sans text-sm pl-7">{fullDescription.interets}</p>
          </div>
        )}

        {fullDescription.role && (
          <div>
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <p class="text-primary font-semibold">Rôle au cabinet</p>
            </div>
            <p class="text-primary/70 font-sans text-sm pl-7">{fullDescription.role}</p>
          </div>
        )}
      </div>
    </div>
  </div>
)}
