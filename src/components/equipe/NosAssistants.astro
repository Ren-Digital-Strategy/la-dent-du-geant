---
import NosAssistantsCard from "./NosAssistantsCard.astro";
import teamData from "../../data/team.json";

// Import des images des assistants
import ysalineImg from "../../assets/assistants/ysaline.png";
import madelineImg from "../../assets/assistants/madeline.png";
import sandrineImg from "../../assets/assistants/sandrine.png";
import inesImg from "../../assets/assistants/ines.png";
import veroniqueImg from "../../assets/assistants/veronique.png";

// Mapping des noms vers les images importées
const imageMap: Record<string, ImageMetadata> = {
  "Ysaline Delbecq": ysalineImg,
  "Madeline Barbosa": madelineImg,
  "Sandrine Meyfroyd": sandrineImg,
  "Inès Lemaire": inesImg,
  "Véronique Gueben": veroniqueImg,
};

const officeManager = (teamData as any).officeManager ?? [];
const assistants = (teamData as any).assistants ?? [];
---

<!-- Office Manager -->
<section class="w-full flex flex-col gap-12 pb-12 md:pb-40">
  <div class="flex flex-col gap-4 mb-20">
    <h2
      class="text-primary font-bold text-3xl lg:text-5xl max-w-2xl"
      data-reveal-title
    >
      Notre <span class="text-[#7B8A96]">office</span> manager
    </h2>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-x-8 lg:gap-y-40 pt-12"
    data-reveal-cards
  >
    {
      officeManager.map((member) => (
        <div data-reveal-card>
          <NosAssistantsCard
            name={member.name}
            role={member.role}
            description={member.description}
            fullDescription={member.fullDescription}
            image={imageMap[member.name]?.src || member.image}
          />
        </div>
      ))
    }
  </div>
</section>

<!-- Équipe d'assistantes -->
<section class="w-full flex flex-col gap-12 pb-12 md:pb-40">
  <div class="flex flex-col gap-4 mb-20">
    <h2
      class="text-primary font-bold text-3xl lg:text-5xl max-w-2xl"
      data-reveal-title
    >
      Notre équipe <span class="text-[#7B8A96]">d'assistantes</span>
    </h2>
    <p class="text-primary/70 font-sans text-base md:text-lg leading-relaxed max-w-3xl" data-reveal-section>
      Inès, Véronique, Madeline et Sandrine sont le cœur battant de l'accueil et de la préparation du cabinet. Elles assurent la stérilisation et la désinfection du matériel, gèrent les stocks et veillent à ce que chaque praticien dispose de tout le nécessaire. Au téléphone, par mail ou en salle d'attente, elles sont aussi votre premier point de contact pour vos prises de rendez-vous, le suivi de votre dossier et toutes vos questions.
    </p>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-x-8 lg:gap-y-40 pt-12"
    data-reveal-cards
  >
    {
      assistants.map((assistant) => (
        <div data-reveal-card>
          <NosAssistantsCard
            name={assistant.name}
            role={assistant.role}
            description={assistant.description}
            fullDescription={assistant.fullDescription}
            image={imageMap[assistant.name]?.src || assistant.image}
          />
        </div>
      ))
    }
  </div>
</section>
