---
import NosAssistantsCard from "./NosAssistantsCard.astro";
import teamData from "../../data/team.json";

// Import des images des assistants
import ysalineImg from "../../assets/assistants/ysaline.png";
import madelineImg from "../../assets/assistants/madeline.png";
import sandrineImg from "../../assets/assistants/sandrine.png";
import inesImg from "../../assets/assistants/ines.png";
import veroniqueImg from "../../assets/assistants/veronique.png";

// Mapping des noms vers les images importées
const imageMap: Record<string, ImageMetadata> = {
  "Ysaline Delbecq": ysalineImg,
  "Madeline Barbosa": madelineImg,
  "Sandrine Meyfroyd": sandrineImg,
  "Inès Lemaire": inesImg,
  "Véronique Gueben": veroniqueImg,
};

const { assistants } = teamData;
---

<section class="w-full flex flex-col gap-12 pb-40">
  <div class="flex flex-col gap-4">
    <h2 class="text-primary font-bold text-3xl lg:text-5xl max-w-2xl">
      Notre équipe d'Assistantes et d'Office Manager
    </h2>
    <p class="text-primary/80 text-base font-sans max-w-xl">
      Chaque praticien apporte son expertise pour construire avec vous le plan
      de traitement le plus adapté.
    </p>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-x-8 lg:gap-y-20 pt-12"
  >
    {
      assistants.map((assistant) => (
        <NosAssistantsCard
          name={assistant.name}
          role={assistant.role}
          description={assistant.description}
          image={imageMap[assistant.name]?.src || assistant.image}
        />
      ))
    }
  </div>
</section>
