---
import NosDentistesCard from "./NosDentistesCard.astro";
import teamData from "../../data/team.json";

// Import des images des dentistes
import julienImg from "../../assets/dentists/julien.png";
import guillemImg from "../../assets/dentists/guillem.png";
import alexImg from "../../assets/dentists/alex.png";
import maxenceImg from "../../assets/dentists/maxence.png";
import alexisImg from "../../assets/dentists/alexis.png";
import audeImg from "../../assets/dentists/aude.png";
import heloiseImg from "../../assets/dentists/heloise.png";

// Mapping des noms vers les images importées
const imageMap: Record<string, ImageMetadata> = {
  "Julien Van de Velde": julienImg,
  "Guillem Busca": guillemImg,
  "Alex Minaberry": alexImg,
  "Maxence Verdebout": maxenceImg,
  "Alexis Fontaine": alexisImg,
  "Aude Quillet": audeImg,
  "Héloïse Caisse": heloiseImg,
};

const { dentists } = teamData;
---

<section class="w-full flex flex-col gap-12 pb-40">
  <div class="flex flex-col gap-4">
    <h2 class="text-primary font-bold text-3xl lg:text-5xl max-w-2xl">
      Nos <span class="text-[#7B8A96]">dentistes</span> et spécialistes
    </h2>
    <p class="text-primary/80 text-base font-sans max-w-xl">
      Chaque praticien apporte son expertise pour construire avec vous le plan
      de traitement le plus adapté.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-x-8 lg:gap-y-20">
    {
      dentists.map((dentist, index) => (
        <NosDentistesCard
          name={dentist.name}
          role={dentist.role}
          description={dentist.description}
          image={imageMap[dentist.name]?.src || dentist.image}
          isFounder={index === 0}
        />
      ))
    }
  </div>
</section>
