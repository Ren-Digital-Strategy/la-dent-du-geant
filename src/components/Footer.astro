---
import { Image } from "astro:assets";
import logoWhite from "../assets/logo blanc.png";
import { Facebook, Instagram } from "@lucide/astro";

const pageLinks = [
  { label: "Accueil", href: "/" },
  { label: "Nos services", href: "/nos-services" },
  { label: "Notre équipe", href: "/equipe" },
  { label: "Contact", href: "/contact" },
];

const schedule = [
  { day: "Lundi", hours: "8:30 AM - 12:30 PM, 2-6 PM" },
  { day: "Mardi", hours: "8:30 AM - 12:30 PM, 2-6 PM" },
  { day: "Mercredi", hours: "8:30 AM - 12:30 PM, 2-4 PM" },
  { day: "Jeudi", hours: "8:30 AM - 12:30 PM, 2-6 PM" },
  { day: "Vendredi", hours: "8:30 AM - 12:30 PM,  2-5 PM" },
  { day: "Samedi", hours: "Fermé" },
  { day: "Dimanche", hours: "Fermé" },
];
---

<footer
  class="relative rounded-[24px] md:rounded-[32px] bg-[#5c544e] overflow-hidden px-4 md:px-8 lg:px-10 py-10 md:py-12 lg:py-16"
>
  <!-- Background pattern overlay -->
  <div class="absolute inset-0 opacity-[0.02] pointer-events-none">
    <div
      class="absolute inset-0 bg-repeat"
      style="background-image: url('data:image/svg+xml,%3Csvg width=%2740%27 height=%2740%27 viewBox=%270 0 40 40%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cg fill=%27%23ffffff%27 fill-opacity=%271%27 fill-rule=%27evenodd%27%3E%3Cpath d=%27M0 40L40 0H20L0 20M40 40V20L20 40%27/%3E%3C/g%3E%3C/svg%3E'); background-size: 1200px 1200px;"
    >
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto">
    <!-- Logo and title -->
    <div
      class="flex items-center justify-center gap-3 md:gap-6 mb-10 md:mb-12 lg:mb-16"
      data-reveal-title
    >
      <Image
        src={logoWhite}
        alt="La Dent du Géant"
        class="w-[25px] h-[32px] md:w-[30px] md:h-[38px] lg:w-[35px] lg:h-[45px]"
        width={35}
        height={45}
      />
      <h2
        class="text-2xl md:text-3xl lg:text-[45px] font-bold text-[#f9f9f9] tracking-tight lg:tracking-[-3.75px]"
      >
        La dent du géant
      </h2>
    </div>

    <!-- Three column content -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 lg:gap-12 mb-10 md:mb-12 lg:mb-16 max-w-[1280px] mx-auto"
      data-reveal-cards
    >
      <!-- Pages Menu -->
      <div class="flex flex-col gap-4" data-reveal-card>
        <h3 class="font-sans text-sm text-[#e2cbb9] tracking-tight">Pages</h3>
        <ul class="flex flex-col gap-2 font-sans">
          {
            pageLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-white text-[15px] md:text-[15.8px] tracking-tight hover:text-tertiary transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="flex flex-col gap-4" data-reveal-card>
        <h3 class="font-sans text-sm text-[#e2cbb9] tracking-tight">Contact</h3>
        <div class="flex flex-col gap-3 text-white font-sans">
          <a
            href="mailto:bienvenue@ladentdugeant.be"
            class="text-[15px] md:text-[16px] leading-[1.2] hover:text-tertiary transition-colors break-all"
          >
            bienvenue@ladentdugeant.be
          </a>
          <p class="text-[15px] md:text-[16px] leading-[1.2]">
            Chaussée de Mons 457,<br />
            7810 Ath, Belgique
          </p>
          <a
            href="tel:+3268282156"
            class="text-[15px] md:text-[16px] leading-[1.5] hover:text-tertiary transition-colors"
          >
            +32 68 28 21 56
          </a>
        </div>
      </div>

      <!-- Schedule -->
      <div class="flex flex-col gap-4 md:col-span-2 lg:col-span-1" data-reveal-card>
        <h3 class="font-sans text-sm text-[#e2cbb9] tracking-tight">
          Horaires
        </h3>
        <div class="flex flex-col gap-1.5 font-sans">
          {
            schedule.map((item) => (
              <div class="flex items-center justify-between text-white gap-4">
                <span class="text-[14px] md:text-[15.8px] tracking-tight min-w-[80px] md:min-w-[100px]">
                  {item.day}
                </span>
                <span class="text-[13px] md:text-[14px] tracking-tight text-right flex-1">
                  {item.hours}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4 max-w-[1280px] mx-auto"
      data-reveal-section
    >
      <!-- Copyright -->
      <div
        class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 font-sans text-white text-xs md:text-[14px] tracking-tight text-center md:text-left"
      >
        <div class="flex items-center gap-1">
          <span>Ladentdugéant</span>
          <svg
            class="w-3 h-3 md:w-4 md:h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          <span>{new Date().getFullYear()}</span>
        </div>
        <span class="hidden sm:inline text-[15.8px] tracking-tight">/</span>
        <a href="#" class="hover:text-tertiary transition-colors">
          Conditions générales
        </a>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-4 md:gap-4">
        <a
          href="#"
          class="text-white hover:text-tertiary transition-colors"
          aria-label="Facebook"
        >
          <Facebook class="w-5 h-5" />
        </a>
        <a
          href="#"
          class="text-white hover:text-tertiary transition-colors"
          aria-label="Instagram"
        >
          <Instagram class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</footer>
