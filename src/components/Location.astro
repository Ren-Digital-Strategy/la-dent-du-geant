---
import { Image } from "astro:assets";
import locationImage from "../assets/location.jpg";
import { Bike, Bus, Car, MapPin, TrainFront } from "@lucide/astro";
---

<section
  class="w-full flex flex-col items-center gap-12 justify-center pt-12 md:pt-24 pb-12 md:pb-32 overflow-hidden"
>
  <div class="flex flex-col items-center justify-center gap-6">
    <h2
      class="text-primary font-bold xl:text-5xl text-3xl flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-center"
      data-reveal-title
    >
      <span>Accédez au cabinet</span>
      <!-- <span
        class="inline-block w-16 h-10 md:w-20 md:h-12 lg:w-24 lg:h-16 rounded-full overflow-hidden shrink-0"
      >
        <Image
          src={locationImage}
          alt="Cabinet dentaire"
          width={1000}
          height={1000}
          class="w-full h-full object-cover"
        />
      </span> -->
      <span>facilement</span>
    </h2>
    <p
      class="text-primary/70 text-base md:text-lg font-sans text-center max-w-3xl"
    >
      Le Cabinet Dentaire La Dent du Géant se trouve à l’entrée de la ville
      d'Ath, vous offrant une accessibilité optimale quel que soit votre moyen
      de transport.
    </p>
    <a
      href="https://maps.app.goo.gl/yizXx1QtEZJgaTuA6"
      target="_blank"
      class="flex items-center gap-2 text-primary/70 text-base md:text-lg font-sans hover:text-primary transition-all duration-300"
    >
      <MapPin class="w-4 h-4" />
      Chaussée de Mons, Ath, Belgium, 7810
    </a>
  </div>
  <div
    class="w-full flex flex-col gap-8 items-center justify-center bg-white p-4 rounded-3xl mt-10"
    data-reveal-scale
  >
    <div class="w-full lg:h-[500px] h-[300px] rounded-2xl overflow-hidden">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2531.813181103583!2d3.796199376439005!3d50.61200887162338!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c255ec1d1ad3db%3A0x606d9967c244d65d!2sLa%20Dent%20du%20G%C3%A9ant!5e0!3m2!1sfr!2sbe!4v1774451168550!5m2!1sfr!2sbe"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="w-full h-full"></iframe>
    </div>

    <div
      class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
      data-reveal-cards
    >
      <div class="w-full flex flex-col gap-6 p-4 rounded-3xl" data-reveal-card>
        <div class="flex items-center gap-2 font-sans font-semibold text-lg">
          <div class="p-3 bg-tertiary/70 rounded-xl">
            <Car class="w-6 h-6" />
          </div>
          En voiture
        </div>
        <p class="text-primary/70 text-base font-sans">
          Parking gratuit réservé à la patientèle directement sur place. Situé
          idéalement à l'entrée de la ville pour éviter le trafic du centre.
        </p>
      </div>

      <div class="w-full flex flex-col gap-6 p-4 rounded-3xl" data-reveal-card>
        <div class="flex items-center gap-2 font-sans font-semibold text-lg">
          <div class="p-3 bg-tertiary/70 rounded-xl">
            <TrainFront class="w-6 h-6" />
          </div>
          En train
        </div>
        <p class="text-primary/70 text-base font-sans">
          À proximité immédiate de la Gare de Maffle.
        </p>
      </div>
      <div class="w-full flex flex-col gap-6 p-4 rounded-3xl" data-reveal-card>
        <div class="flex items-center gap-2 font-sans font-semibold text-lg">
          <div class="p-3 bg-tertiary/70 rounded-xl">
            <Bus class="w-6 h-6" />
          </div>
          En bus
        </div>
        <p class="text-primary/70 text-base font-sans">
          Arrêt de bus situé juste en face du cabinet.
        </p>
      </div>
      <div class="w-full flex flex-col gap-6 p-4 rounded-3xl" data-reveal-card>
        <div class="flex items-center gap-2 font-sans font-semibold text-lg">
          <div class="p-3 bg-tertiary/70 rounded-xl">
            <Bike class="w-6 h-6" />
          </div>
          À Vélo & Piéton
        </div>
        <p class="text-primary/70 text-base font-sans">
          Accès direct et sécurisé via le RAVeL qui passe à proximité directe du
          cabinet. Parking vélo disponible pour stationner votre deux-roues en
          sécurité.
        </p>
      </div>
    </div>
  </div>
</section>
