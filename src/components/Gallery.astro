---
import { Image } from "astro:assets";

import imgFacade from "../assets/cabinet/cabinet-dentaire-ath-facade-exterieure.jpg";
import imgSalle from "../assets/cabinet/cabinet-dentaire-ath-salle-de-soins.jpg";
import imgEquipe from "../assets/cabinet/cabinet-dentaire-ath-equipe-photo-groupe-exterieur.jpg";
import imgConeBeam from "../assets/cabinet/cabinet-dentaire-ath-cone-beam-ct.jpg";
import imgAttente from "../assets/cabinet/cabinet-dentaire-ath-salle-attente.jpg";
import imgLoupes from "../assets/cabinet/cabinet-dentaire-ath-praticien-loupes-soin.jpg";
import imgAccueil from "../assets/cabinet/cabinet-dentaire-ath-espace-accueil-secretariat.jpg";
import imgComptoir from "../assets/cabinet/cabinet-dentaire-ath-accueil-patient-comptoir.jpg";

import imgEmpreinte from "../assets/cabinet/cabinet-dentaire-ath-empreinte-numerique-3shape.jpg";
import imgSoin from "../assets/cabinet/cabinet-dentaire-ath-soin-fauteuil-equipe.jpg";
import imgImprimante from "../assets/cabinet/cabinet-dentaire-ath-imprimante-3d.jpg";
import imgJardin from "../assets/cabinet/cabinet-dentaire-ath-batiment-exterieur-jardin.jpg";
import imgSterili from "../assets/cabinet/cabinet-dentaire-ath-salle-sterilisation-01.jpg";
import imgRadio from "../assets/cabinet/cabinet-dentaire-ath-radiographie-panoramique-ecran.jpg";
import imgFauteuil from "../assets/cabinet/cabinet-dentaire-ath-fauteuil-instruments.jpg";
import imgMicroscope from "../assets/cabinet/cabinet-dentaire-ath-endodontie-microscope.jpg";

const topRow = [imgFacade, imgSalle, imgEquipe, imgConeBeam, imgAttente, imgLoupes, imgAccueil, imgComptoir];
const bottomRow = [imgEmpreinte, imgSoin, imgImprimante, imgJardin, imgSterili, imgRadio, imgFauteuil, imgMicroscope];
---

<section
  class="w-full flex flex-col items-center gap-12 justify-center pt-12 md:pt-24 pb-12 md:pb-32 overflow-hidden"
>
  <h2
    class="relative text-primary font-bold max-w-2xl text-center text-3xl lg:text-5xl px-4 mx-auto"
    data-reveal-title
  >
    <span class="text-tertiary">Découvrez notre galerie :</span> un sourire à chaque
    étape!
  </h2>

  <!-- Marquee Container - Full screen with negative margins -->
  <div class="marquee-wrapper" data-reveal-section>
    <!-- Top Row - scrolls left -->
    <div class="marquee-container">
      <div class="marquee-track marquee-left">
        {
          [...topRow, ...topRow, ...topRow].map((img, index) => (
            <div class="marquee-item">
              <Image
                src={img}
                alt={`Galerie ${(index % topRow.length) + 1}`}
                width={1000}
                height={1000}
                class="w-full h-full object-cover rounded-[16px] md:rounded-[20px]"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom Row - scrolls right -->
    <div class="marquee-container">
      <div class="marquee-track marquee-right">
        {
          [...bottomRow, ...bottomRow, ...bottomRow].map((img, index) => (
            <div class="marquee-item">
              <Image
                src={img}
                alt={`Galerie ${(index % bottomRow.length) + 1}`}
                width={1000}
                height={1000}
                class="w-full h-full object-cover rounded-[16px] md:rounded-[20px]"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-wrapper {
    width: 100vw;
    margin-left: calc(-40px);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }

  .marquee-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    /* Fade effect using mask */
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    gap: 1rem;
    width: max-content;
  }

  .marquee-item {
    flex-shrink: 0;
    width: 180px;
    height: 130px;
  }

  @media (min-width: 640px) {
    .marquee-item {
      width: 250px;
      height: 180px;
    }
  }

  @media (min-width: 768px) {
    .marquee-item {
      width: 320px;
      height: 230px;
    }
  }

  @media (min-width: 1024px) {
    .marquee-item {
      width: 400px;
      height: 280px;
    }
  }

  .marquee-left {
    animation: scroll-left 40s linear infinite;
  }

  .marquee-right {
    animation: scroll-right 40s linear infinite;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% / 3));
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(calc(-100% / 3));
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Pause on hover */
  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }
</style>
