---
import { Image } from "astro:assets";
import forme from "../../assets/forme.png";

import card1 from "../../assets/about/mal-de-dent-3.png";
import card2 from "../../assets/about/mal-de-dent-2-2.png";
import card3 from "../../assets/about/mal-de-dent-1.png";
import card4 from "../../assets/about/mal-de-dent-4.png";
import AboutCard from "./AboutCard.astro";

interface Card {
  description: string;
  image: ImageMetadata;
  imageClass?: string;
}

const cards: Card[] = [
  {
    description: "Des douleurs dentaires vous gâchent le quotidien ?",
    image: card1,
  },
  {
    description: "Manger est devenu inconfortable ou difficile ?",
    image: card2,
  },
  {
    description: "Vous êtes complexé(e) par l'apparence de votre sourire ?",
    image: card3,
  },
  {
    description:
      "Vous craignez de perdre vos dents et cherchez des solutions durables ?",
    image: card4,
  },
];
---

<section
  class="w-full flex flex-col items-center gap-8 justify-center pt-12 md:pt-40 pb-12 md:pb-24"
>
  <div
    class="relative w-full max-w-7xl flex flex-col items-center justify-center"
  >
    <h2
      class="relative text-primary font-bold max-w-2xl text-center text-3xl lg:text-5xl"
      data-reveal-title
    >
      Vous vous reconnaissez dans l'une de ces <span class="text-tertiary"
        >situations ?</span
      >
      <Image
        class="w-12 absolute -top-10 -right-14 hidden lg:block"
        src={forme}
        alt="Forme"
        width={1000}
        height={1000}
      />
    </h2>
  </div>

  <div
    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 w-full"
    data-reveal-cards
  >
    {
      cards.map((card, index) => (
        <div data-reveal-card>
          <AboutCard
            key={index}
            description={card.description}
            image={card.image}
            imageClass={card.imageClass}
          />
        </div>
      ))
    }
  </div>
</section>
