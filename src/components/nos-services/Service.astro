---
const services = [
  {
    title: "Bilan Dentaire",
    description:
      "Examen complet de votre bouche (dents, gencives, mâchoire) pour diagnostiquer d'éventuels problèmes et établir un plan de traitement, au moyen d'une radio panoramique intra-buccale Cone Beam CT.",
  },
  {
    title: "Prévention et hygiène",
    description:
      "Conseils personnalisés pour un brossage efficace et une bonne hygiène bucco-dentaire, ainsi que détartrage pour maintenir des gencives saines.",
  },
  {
    title: "Traitement d'une carie",
    description:
      "Intervention qui consiste à nettoyer la partie de la dent abîmée par les bactéries et à la reboucher pour stopper sa progression.",
  },
  {
    title: "Prothèse fixe",
    description:
      "Sur dents naturelles : facettes, onlays, veneerlays, bridges cantilever, couronnes, bridges. Sur implants : couronne unitaire ou bridge.",
  },
  {
    title: "Prothèse amovible",
    description:
      "Complète ou partielle : provisoire en résine ou définitive squelettique.",
  },
  {
    title: "Implant",
    description:
      "Racine artificielle en titane insérée dans l'os de la mâchoire, servant de fondation solide pour une future couronne ou prothèse.",
  },
  {
    title: "Dévitalisation",
    description:
      "Intervention qui consiste à retirer le nerf d'une dent infectée ou endommagée pour la soulager et éviter son extraction.",
  },
  {
    title: "Éclaircissement",
    description:
      "Soin esthétique qui vise à rendre vos dents plus blanches et à redonner de l'éclat à votre sourire.",
  },
  {
    title: "Occlusodontie",
    description:
      "Analyse et correction des contacts entre les dents et traitement du bruxisme pour améliorer le confort de mastication.",
  },
];
---

<section
  class="w-full flex flex-col items-center gap-12 justify-center pb-12 md:pb-40"
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-8" data-reveal-cards>
    {
      services.map((service) => (
        <div class="col-span-1 flex flex-col gap-4 bg-white rounded-3xl p-6" data-reveal-card>
          <h2 class="text-primary font-semibold text-lg lg:text-2xl">
            {service.title}
          </h2>
          <p class="text-primary/80 text-base font-sans">
            {service.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
