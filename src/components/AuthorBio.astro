---
// Composant réutilisable "À propos de l'auteur" (EEAT).
// Utilisable sur la home, les pages piliers et les articles de blog.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name?: string;
  role?: string;
  bio?: string;
  image?: string; // URL (public/) — fallback non optimisé (ex. blog)
  imageData?: ImageMetadata; // image importée de src/assets -> optimisée via <Image>
  imageAlt?: string;
  eyebrow?: string;
  linkHref?: string;
  linkLabel?: string;
}

const {
  name = "Dr Julien Van de Velde",
  role = "Fondateur & gérant · Dentiste généraliste et endodontiste spécialiste",
  bio = "Diplômé de l'UCL (2016) et titulaire d'un certificat universitaire en endodontie spécialisée, Julien a fondé La Dent du Géant en 2022 avec l'ambition d'une dentisterie préventive et conservatrice — où chaque soin est réalisé sous digue et expliqué au patient.",
  image = "/images/equipe/julien-vandevelde.png",
  imageData,
  imageAlt = "Dr Julien Van de Velde, fondateur du cabinet dentaire La Dent du Géant à Ath",
  eyebrow = "À propos de l'auteur",
  linkHref = "/equipe",
  linkLabel = "Découvrir toute l'équipe",
} = Astro.props;
---

<section class="w-full py-12 md:py-20">
  <div
    class="max-w-5xl mx-auto bg-white rounded-[24px] md:rounded-[32px] overflow-hidden flex flex-col md:flex-row"
  >
    <!-- Photo -->
    <div
      class="relative md:w-2/5 lg:w-1/3 shrink-0 bg-tertiary/20"
      data-reveal-left
    >
      {
        imageData ? (
          <Image
            src={imageData}
            alt={imageAlt}
            width={600}
            height={800}
            class="w-full h-64 md:h-full object-cover object-top"
            loading="lazy"
          />
        ) : (
          <img
            src={image}
            alt={imageAlt}
            class="w-full h-64 md:h-full object-cover object-top"
            loading="lazy"
          />
        )
      }
    </div>

    <!-- Texte -->
    <div
      class="flex flex-col gap-3 md:gap-4 p-6 md:p-10 lg:p-12 md:w-3/5 lg:w-2/3 justify-center"
      data-reveal-right
    >
      <span
        class="text-quaternary font-semibold text-xs md:text-sm uppercase tracking-wide"
        >{eyebrow}</span
      >
      <div class="flex flex-col gap-1">
        <h2 class="text-primary font-bold text-xl md:text-2xl lg:text-3xl">
          {name}
        </h2>
        <p class="text-primary/60 font-sans text-sm md:text-base">{role}</p>
      </div>
      <p class="text-primary/80 font-sans text-sm md:text-base leading-relaxed">
        {bio}
      </p>
      {
        linkHref && (
          <a
            href={linkHref}
            class="mt-1 md:mt-2 inline-flex w-fit items-center gap-2 text-primary border border-primary/20 hover:border-primary px-4 py-2 rounded-full font-semibold font-sans text-sm md:text-base transition-all duration-300"
          >
            {linkLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
