---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Animations from "../components/Animations.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
}
const {
  title,
  description,
  canonical,
  noindex,
  ogImage = "https://www.ladentdugeant.be/images/cabinet/cabinet-dentaire-ath-facade-exterieure.jpg",
  ogType = "website",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-W9NQN4RD");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Réseaux sociaux -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="La Dent du Géant" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_BE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W9NQN4RD"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >

    <!-- End Google Tag Manager (noscript) -->
    <div id="mountains-bg" aria-hidden="true" style="position:fixed;bottom:0;left:0;width:100%;z-index:-1;pointer-events:none;">
      <svg width="100%" viewBox="0 0 949 350" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax slice">
        <path d="M597.111 349.042L544.963 197.345L476.351 239.575C467.999 244.7 462.732 253.62 454.998 259.741C449.921 271.509 455.33 278.057 444.749 285.744C442.756 287.215 438.438 291.58 438.96 294.285C441.238 306.195 443.847 317.156 445.556 330.252L414.95 290.536C408.924 281.284 399.671 273.407 395.78 262.92L369.636 192.125L300.691 268.235L293.288 219.409L289.398 192.6L266.669 203.039L254.237 147.19C247.025 114.782 249.255 80.8548 242.944 46.7383L158.91 177.178L107.901 294.143L66.9519 197.819L6.31085 276.776C4.2705 278.057 2.7521 278.769 0 279.67L0.0949 258.84L40.9019 205.743L70.7005 167.166L113.406 207.973C115.92 210.346 122.231 211.674 125.505 211.58L143.868 170.346L255.518 0L319.481 148.946L335.804 146.288L347.714 191.888C358.532 181.449 365.887 172.813 375.709 161.899L433.93 223.584L456.991 230.892C459.174 231.603 464.678 232.22 466.955 230.749L552.128 176.704C565.746 184.77 578.558 191.556 591.227 200.049C604.655 209.017 615.948 219.266 629.234 229.326L659.745 225.008L696.376 176.609L756.353 210.109L769.971 227.665L834.361 248.211L855.951 276.586L911.799 207.072C921.289 209.824 948.763 227.001 948.715 236.965L948.336 288.306C949.047 293.716 949.712 298.603 946.865 304.392L911.847 228.092L827.765 338.888C819.224 326.124 817.753 312.221 809.402 301.64C797.919 287.073 785.108 274.546 771.49 260.738L747.527 302.257C738.749 291.533 729.401 284.605 723.043 274.261L695.19 205.221L597.111 349.09V349.042Z" fill="#D7B899" opacity="0.3"/>
      </svg>
    </div>
    <slot />
    <Animations />
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-secondary);
  }
</style>

