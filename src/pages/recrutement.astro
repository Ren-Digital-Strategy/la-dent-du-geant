---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import equipe from "../assets/equipe/2.jpg";
const DIRECTUS_URL = import.meta.env.DIRECTUS_URL || "http://localhost:8055";

interface OffreEmploi {
  id: string;
  titre: string;
  description: string;
  localisation: string;
  type_contrat: string;
  salaire: string;
  date_created: string;
  status: string;
  regime_travail: string;
  disponibilite: string;
  remuneration: string;
  avantages: string;
  profil_recherche: string;
}

let offres: OffreEmploi[] = [];

try {
  console.log("DIRECTUS_URL pour recrutement:", DIRECTUS_URL);
  const url = `${DIRECTUS_URL}/items/recrutement?filter[status][_eq]=published&fields=id,titre,description,localisation,type_contrat,date_created,regime_travail,disponibilite,remuneration,avantages,profil_recherche&sort=-date_created`;
  console.log("Fetching recrutement from:", url);

  const response = await fetch(url);
  console.log("Response status:", response.status);

  if (response.ok) {
    const data = await response.json();
    console.log("Offres récupérées:", data.data?.length || 0);
    offres = data.data || [];
  } else {
    console.error("Erreur HTTP:", response.status, response.statusText);
  }
} catch (error) {
  console.error("Erreur lors de la récupération des offres:", error);
}

function formatDate(dateString: string) {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat("fr-FR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
}
---

<Layout title="La Dent du Geant - Recrutement">
  <div class="px-4 md:px-8 lg:px-10">
    <Header />

    <!-- Section Hero -->
    <section
      class="w-full flex flex-col items-center justify-center pt-12 pb-12 lg:pt-32 lg:pb-24 gap-12 lg:gap-24"
    >
      <div
        class="w-full max-w-3xl flex flex-col items-center gap-4 lg:gap-6 px-4"
      >
        <h1
          class="text-3xl md:text-4xl lg:text-6xl font-extrabold text-[#3c3c3c] text-center leading-tight lg:leading-[72px] tracking-[-0.8px] lg:tracking-[-1.2px]"
          data-hero-title
          style="clip-path: inset(0 0 100% 0); transform: translateY(100%);"
        >
          Rejoignez une équipe engagée et bienveillante
        </h1>
        <p
          class="text-base md:text-lg lg:text-xl text-[#3c3c3c] text-center leading-6 lg:leading-[30px]"
          data-hero-text
          style="clip-path: inset(0 0 100% 0); transform: translateY(100%);"
        >
          Rejoignez une équipe passionnée, dans un environnement professionnel,
          moderne et tourné vers l'avenir.
        </p>
      </div>

      <!-- Liste des offres -->
      <div
        class="w-full max-w-3xl flex flex-col gap-4 lg:gap-6 px-4"
        data-reveal-cards
      >
        {
          offres.length === 0 ? (
            <div class="text-center py-12">
              <p class="text-[#535862] text-base lg:text-lg">
                Aucune offre d'emploi disponible pour le moment.
              </p>
            </div>
          ) : (
            offres.map((offre, index) => (
              <article
                class="bg-[#fdf9f2] border border-[#e9eaeb] rounded-2xl p-4 md:p-6 lg:p-8 flex flex-col gap-4 lg:gap-6 relative"
                data-offre-id={index}
                data-reveal-card
              >
                {/* Date de publication - cachée sur mobile */}
                <p class="hidden md:block absolute top-1 right-28 text-xs text-[#535862] font-medium">
                  Publié le {formatDate(offre.date_created)}
                </p>

                {/* Titre et description */}
                <div class="flex flex-col gap-3 lg:gap-5">
                  <h2 class="text-lg md:text-xl lg:text-[22px] font-semibold text-[#3c3c3c] leading-[1.4] tracking-[-0.308px]">
                    {offre.titre}
                  </h2>
                  <p class="text-sm md:text-base text-[#535862] leading-5 md:leading-6">
                    {offre.description}
                  </p>
                </div>

                {/* Date de publication - visible sur mobile */}
                <p class="md:hidden text-xs text-[#535862] font-medium">
                  Publié le {formatDate(offre.date_created)}
                </p>

                {/* Bouton Voir l'offre */}
                <a
                  href={`/recrutement/${offre.id}`}
                  class="flex items-center gap-2 text-sm font-semibold text-[#535862] hover:text-[#3c3c3c] transition-colors duration-200 w-fit"
                >
                  <span>Voir l'offre complète</span>
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>

                {/* Détails et bouton */}
                <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-5 w-full">
                  {/* Détails */}
                  <div class="flex-1 flex flex-wrap items-center gap-3 md:gap-4">
                    {/* Localisation */}
                    <div class="flex items-center gap-1.5">
                      <svg
                        class="w-4 h-4 text-[#535862] flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                      <span class="text-xs md:text-sm font-semibold text-[#535862]">
                        {offre.localisation}
                      </span>
                    </div>

                    {/* Type de contrat (masqué pour les indépendants) */}
                    {!offre.type_contrat?.toLowerCase().includes("indépendant") && (
                      <div class="flex items-center gap-1.5">
                        <svg
                          class="w-4 h-4 text-[#535862] flex-shrink-0"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                          />
                        </svg>
                        <span class="text-xs md:text-sm font-semibold text-[#535862]">
                          {offre.type_contrat}
                        </span>
                      </div>
                    )}

                      </div>

                  {/* Bouton Voir l'offre */}
                  <a
                    href={`/recrutement/${offre.id}`}
                    class="bg-[#3c3c3c] text-white px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-[#2c2c2c] transition-colors duration-200 text-center md:text-left whitespace-nowrap"
                  >
                    Voir l'offre
                  </a>
                </div>
              </article>
            ))
          )
        }
      </div>

      <!-- Note candidatures spontanées -->
      <div class="w-full max-w-3xl px-4 mt-4">
        <p class="text-sm text-[#535862] italic leading-relaxed">
          L'équipe d'assistants-secrétaires est au complet pour l'instant. Les candidatures spontanées sont toutefois acceptées sur{" "}
          <a
            href="mailto:bienvenue@ladentdugeant.be"
            class="underline hover:text-[#3c3c3c] transition-colors duration-200"
          >
            bienvenue@ladentdugeant.be
          </a>{" "}
          pour notre réserve de recrutement.
        </p>
      </div>
    </section>

    <!-- Section CTA Contact -->
    <section
      class="w-full flex flex-col items-center justify-center pb-12 md:py-16 lg:py-32"
    >
      <div
        class="w-full max-w-7xl flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16 px-4"
      >
        <!-- Image avec citation -->
        <div
          class="w-full lg:w-[560px] h-[400px] md:h-[500px] lg:h-[614px] rounded-3xl relative overflow-hidden"
          data-reveal-scale
        >
          <Image
            src={equipe}
            alt="Recrutement"
            class="absolute inset-0 w-full h-full object-cover"
            width={1000}
            height={1000}
          />
          <!-- Overlay avec citation -->
          <div
            class="absolute bottom-0 left-0 right-0 pt-24 rounded-3xl bg-gradient-to-b from-transparent to-black/50"
          >
            <div
              class="backdrop-blur-xl bg-white/30 border-t border-white/30 p-6 md:p-8 rounded-b-3xl"
            >
              <p
                class="text-lg md:text-xl lg:text-2xl font-semibold text-white mb-6 md:mb-8"
              >
                "Ici, chaque personne compte. Nous avançons ensemble, avec
                confiance et esprit d'équipe"
              </p>
              <div class="flex flex-col gap-1">
                <p class="text-base md:text-lg font-semibold text-white">
                  Julien Van de Velde
                </p>
                <p class="text-sm font-medium text-white/90">
                  Gérant du cabinet
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenu texte et bouton -->
        <div
          class="w-full lg:w-[560px] flex flex-col gap-8 lg:gap-12"
          data-reveal-right
        >
          <div class="flex flex-col gap-4 lg:gap-6">
            <h2
              class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#3c3c3c] leading-tight tracking-tight"
            >
              Une question ? Parlons-en simplement.
            </h2>
            <p
              class="text-base md:text-lg lg:text-xl text-[#535862] leading-relaxed"
            >
              Si vous avez la moindre question sur nos opportunités ou notre
              façon de travailler, notre équipe se tient à votre écoute.
            </p>
          </div>

          <!-- Bouton Contact -->
          <a
            href="mailto:bienvenue@ladentdugeant.be"
            class="bg-[#3c3c3c] hover:bg-[#2c2c2c] transition-colors duration-200 flex items-center justify-between pl-3 pr-1.5 py-1.5 rounded-full w-fit group"
          >
            <span class="text-base md:text-lg font-semibold text-white px-3">
              Contactez le cabinet
            </span>
            <div
              class="bg-[#f8f1e7] rounded-full p-2.5 md:p-3 flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 md:w-6 md:h-6 text-[#3c3c3c] transform -rotate-45 group-hover:scale-110 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
