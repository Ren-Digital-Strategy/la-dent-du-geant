---
// PAGE DE TEST — v2 SEO de la page d'accueil (cluster "dentiste ath").
// NE remplace PAS la page d'accueil : accessible sur /accueil-test.
// Réutilise les composants partagés (non modifiés) + couche v2 inline.
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/about/About.astro";
import Goal from "../components/goal/Goal.astro";
import Features from "../components/features/Features.astro";
import Team from "../components/team/Team.astro";
import Gallery from "../components/Gallery.astro";
import Tarification from "../components/Tarification.astro";
import Testimonial from "../components/testimonials/Testimonial.astro";
import Faq from "../components/Faq.astro";
import Location from "../components/Location.astro";
import BigCta from "../components/BigCta.astro";
import Footer from "../components/Footer.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { ArrowUpRight, Users, Star, Building2 } from "@lucide/astro";
import { Image } from "astro:assets";

// Images optimisées (src/assets -> Astro <Image>)
import imgConeBeam from "../assets/cabinet/cabinet-dentaire-ath-cone-beam-ct.jpg";
import imgEmpreinte from "../assets/cabinet/cabinet-dentaire-ath-empreinte-numerique-3shape.jpg";
import imgMicroscope from "../assets/cabinet/cabinet-dentaire-ath-endodontie-microscope.jpg";
import imgImprimante from "../assets/cabinet/cabinet-dentaire-ath-imprimante-3d.jpg";
import imgAutoclave from "../assets/cabinet/cabinet-dentaire-ath-autoclave-sterilisateur.jpg";
import imgSalle from "../assets/cabinet/cabinet-dentaire-ath-salle-de-soins.jpg";
import imgJulien from "../assets/equipe/julien-vandevelde.png";

// Plateau technique
const plateau = [
  { img: imgConeBeam, titre: "Cone Beam CT (scanner 3D)", texte: "Une image 3D des dents, des os et des nerfs pour planifier implants et interventions en sécurité, avec une faible dose de rayons." },
  { img: imgEmpreinte, titre: "Empreinte numérique", texte: "Une caméra 3D scanne vos dents en quelques minutes : plus de confort et des prothèses parfaitement ajustées." },
  { img: imgMicroscope, titre: "Microscope opératoire", texte: "Une précision extrême pour l'endodontie, utile pour sauver des dents qui auraient pu être perdues." },
  { img: imgImprimante, titre: "Imprimante 3D", texte: "La fabrication sur place de modèles, gouttières et guides chirurgicaux, plus rapide et plus fiable." },
  { img: imgAutoclave, titre: "Stérilisation aux normes", texte: "Une chaîne complète (laveur-désinfecteur, autoclave, ensachage) pour des soins réalisés sous digue, en toute sécurité." },
  { img: imgSalle, titre: "Salles de soins modernes", texte: "Un environnement lumineux et apaisant, pensé pour votre confort à chaque rendez-vous." },
];

// Gamme complète de soins (maillage interne — liens à activer quand les pages existeront)
const specialites = [
  { titre: "Bilans & prévention", texte: "Bilan dentaire complet, contrôle annuel, détartrage et conseils d'hygiène personnalisés." },
  { titre: "Soins conservateurs", texte: "Traitement des caries et réparations, dans l'esprit de préserver la dent naturelle." },
  { titre: "Endodontie spécialisée", texte: "Traitements de canaux radiculaires complexes, réalisés au microscope." },
  { titre: "Implantologie & prothèses", texte: "Pose et suivi d'implants, couronnes, bridges, prothèses fixes ou amovibles." },
  { titre: "Esthétique & occlusodontie", texte: "Éclaircissement, facettes, et gouttières sur mesure pour le bruxisme." },
];

// JSON-LD (repris de 05-meta-schema.json)
const schemaDentist = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: "La Dent du Géant",
  legalName: "Cabinet Dentaire La Dent du Géant",
  url: "https://www.ladentdugeant.be",
  telephone: "+3268282156",
  email: "bienvenue@ladentdugeant.be",
  vatID: "BE0734640287",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Chaussée de Mons 457",
    addressLocality: "Ath",
    postalCode: "7810",
    addressCountry: "BE",
  },
  areaServed: ["Ath", "Maffle", "Wallonie picarde"],
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], opens: "08:30", closes: "18:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Friday", opens: "08:30", closes: "17:00" },
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.3", reviewCount: "29" },
  founder: { "@type": "Person", name: "Julien Van de Velde" },
  foundingDate: "2022-08-01",
};

// JSON-LD FAQ — aligné mot pour mot sur la FAQ réellement affichée (composant Faq)
const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "Acceptez-vous de nouveaux patients ?", acceptedAnswer: { "@type": "Answer", text: "Oui, nous accueillons de nouveaux patients avec plaisir. Cependant, pour garantir une qualité de soins irréprochable et des délais raisonnables pour tous, nous sommes parfois contraints de réguler les nouvelles inscriptions. Nous vous invitons à nous contacter par téléphone pour connaître nos disponibilités actuelles." } },
    { "@type": "Question", name: "Que signifie être un cabinet « déconventionné » pour mes remboursements ?", acceptedAnswer: { "@type": "Answer", text: "Être déconventionné nous offre la liberté d'utiliser les meilleures techniques et matériaux sans être limités par les contraintes de temps imposées par l'INAMI. Concrètement, la mutuelle vous rembourse la base légale habituelle, et la différence d'honoraires reste à votre charge (ou à celle de votre assurance dentaire complémentaire si vous en avez une). C'est le choix d'une dentisterie de qualité, sans compromis." } },
    { "@type": "Question", name: "Je suis très anxieux(se) chez le dentiste, comment cela se passe-t-il ?", acceptedAnswer: { "@type": "Answer", text: "Nous savons que la visite chez le dentiste peut être source de stress. Notre équipe est formée pour vous écouter et vous mettre à l'aise. Nous prenons le temps de vous expliquer chaque geste avant de le réaliser. Grâce à nos techniques modernes et à une anesthésie maîtrisée, la très grande majorité des soins se déroulent aujourd'hui sans aucune douleur." } },
    { "@type": "Question", name: "Le cabinet est-il facilement accessible (parking, mobilité douce) ?", acceptedAnswer: { "@type": "Answer", text: "Absolument. Un parking privé et gratuit est réservé à notre patientèle juste devant le cabinet. La Gare de Maffle est toute proche et un arrêt de bus se trouve en face. Pour les cyclistes, le cabinet est desservi par le RAVeL et dispose d'un parking vélos." } },
    { "@type": "Question", name: "Comment se déroule une première consultation ?", acceptedAnswer: { "@type": "Answer", text: "Sauf en cas d'urgence douloureuse, le premier rendez-vous n'est généralement pas destiné à réaliser un soin. C'est un moment d'échange et de diagnostic complet (examen clinique, radiographies, photos). Cela nous permet d'établir une estimation d'honoraires précise et de vous expliquer les différentes options de traitement avant de commencer." } },
  ],
};
---

<Layout
  title="Dentiste à Ath | Cabinet dentaire La Dent du Géant (Maffle)"
  description="Cabinet dentaire pluridisciplinaire à Ath (Maffle) : équipe de 12 praticiens, plateau technique moderne, soins sous digue. RDV au +32 68 28 21 56."
  canonical="https://www.ladentdugeant.be/"
  noindex
>
  <!-- JSON-LD v2 -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaDentist)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} is:inline />

  <div class="px-4 md:px-8 lg:px-10">
    <Header />

    <!-- HERO : composant d'origine (slider + étiquettes + animations).
         H1 SEO discret + nouveau texte ; accroche et CTA inchangés. -->
    <Hero
      h1="Dentiste à Ath — Cabinet dentaire La Dent du Géant (Maffle)"
      text="Un cabinet pluridisciplinaire à l'entrée d'Ath : une équipe de 12 membres, un plateau technique de pointe et des soins réalisés sous digue, où l'on prend le temps de tout vous expliquer."
    />

    <!-- INTRO pluridisciplinaire — passage le plus dense en sémantique "dentiste à Ath" -->
    <section class="w-full py-12 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 items-stretch">

        <!-- Carte texte gauche -->
        <div class="bg-primary rounded-3xl p-8 md:p-10 lg:p-12 flex flex-col gap-5">
          <span class="text-tertiary font-semibold text-sm uppercase tracking-wide">
            Cabinet dentaire à Ath (Maffle)
          </span>
          <h2 class="text-white font-bold text-2xl md:text-3xl lg:text-4xl" data-reveal-title>
            Un cabinet dentaire pluridisciplinaire à l'entrée d'Ath
          </h2>
          <p class="text-white/65 text-base md:text-lg font-sans leading-relaxed">
            Trouver un dentiste à Ath en qui placer sa confiance n'est pas toujours simple. À Maffle, le long de
            la Chaussée de Mons, le cabinet dentaire La Dent du Géant réunit en un seul lieu des compétences
            souvent dispersées : dentistes généralistes, endodontiste spécialiste, implantologue et hygiéniste
            dentaire. Notre approche est celle d'une dentisterie préventive et conservatrice — préserver vos dents
            naturelles le plus longtemps possible, avec un plateau technique de pointe et des soins expliqués pas
            à pas.
          </p>
        </div>

        <!-- Bento 2×2 droite -->
        <div class="grid grid-cols-2 gap-4 md:gap-5" data-reveal-cards>

          <!-- 12 praticiens -->
          <div class="bg-white/60 backdrop-blur-md border border-white/40 rounded-[24px] p-6 md:p-7 flex flex-col gap-3" data-reveal-card>
            <div class="w-11 h-11 rounded-2xl bg-tertiary/20 flex items-center justify-center">
              <Users class="text-quaternary w-5 h-5" />
            </div>
            <span class="text-tertiary font-bold text-4xl md:text-5xl leading-none">12</span>
            <span class="text-primary/70 text-sm font-sans leading-snug">membres du cabinet (4 généralistes, 1 endodontiste, 1 implantologue, 1 hygiéniste, 4 assistantes-secrétaires, 1 office manager)</span>
          </div>

          <!-- 4,3/5 -->
          <div class="bg-white/60 backdrop-blur-md border border-white/40 rounded-[24px] p-6 md:p-7 flex flex-col gap-3" data-reveal-card>
            <div class="w-11 h-11 rounded-2xl bg-tertiary/20 flex items-center justify-center">
              <Star class="text-quaternary w-5 h-5" fill="currentColor" />
            </div>
            <span class="text-tertiary font-bold text-4xl md:text-5xl leading-none">4,3/5</span>
            <span class="text-primary/70 text-sm font-sans leading-snug">sur 29 avis Google</span>
          </div>

          <!-- 2022 — pleine largeur -->
          <div class="col-span-2 bg-white/60 backdrop-blur-md border border-white/40 rounded-[24px] p-6 md:p-7 flex items-center gap-5" data-reveal-card>
            <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-tertiary/20 flex items-center justify-center">
              <Building2 class="text-quaternary w-6 h-6" />
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-tertiary font-bold text-4xl md:text-5xl leading-none">2022</span>
              <span class="text-primary/70 text-sm md:text-base font-sans">cabinet ouvert à Maffle (Ath)</span>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>

  <Gallery />

  <div class="px-4 md:px-8 lg:px-10">
    <About />
    <Goal glass />
    <Features />

    <!-- PLATEAU TECHNIQUE v2 (photos renommées) -->
    <section class="w-full py-12 md:py-24 flex flex-col gap-8 md:gap-12">
      <div class="flex flex-col gap-3 max-w-3xl">
        <span class="text-quaternary font-semibold text-sm md:text-base uppercase tracking-wide">Plateau technique</span>
        <h2 class="text-primary font-bold text-2xl md:text-3xl lg:text-4xl" data-reveal-title>
          Des technologies de pointe, des soins sous digue
        </h2>
        <p class="text-primary/70 text-sm md:text-base font-sans">
          Un équipement que peu de cabinets réunissent, toujours au service d'un bénéfice concret pour vous :
          plus de précision, plus de confort, des résultats durables.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6" data-reveal-cards>
        {
          plateau.map((p) => (
            <article class="bg-white rounded-3xl overflow-hidden flex flex-col" data-reveal-card>
              <div class="w-full h-48 md:h-56 overflow-hidden">
                <Image src={p.img} alt={`${p.titre} — cabinet dentaire à Ath`} width={800} height={600} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="flex flex-col gap-2 p-5 md:p-6">
                <h3 class="text-primary font-semibold text-lg md:text-xl">{p.titre}</h3>
                <p class="text-primary/70 text-sm md:text-base font-sans">{p.texte}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <Team
      intro="Douze praticiens et collaborateurs vous accueillent au cabinet dentaire La Dent du Géant à Ath : dentistes généralistes, endodontiste spécialiste, implantologue et hygiéniste dentaire, tous diplômés des universités belges (UCL, ULB, ULiège). En formation continue, l'équipe travaille en coordination — de l'accueil et du suivi de votre dossier jusqu'aux soins — pour une prise en charge globale."
    />
  </div>

  <div class="px-4 md:px-8 lg:px-10">
    <!-- DENTISTERIE PRÉVENTIVE ET CONSERVATRICE v2 -->
    <section class="w-full py-12 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">
      <div class="flex flex-col gap-4 max-w-2xl">
        <span class="text-quaternary font-semibold text-sm md:text-base uppercase tracking-wide">Notre philosophie</span>
        <h2 class="text-primary font-bold text-2xl md:text-3xl lg:text-4xl" data-reveal-title>
          Une dentisterie préventive et conservatrice
        </h2>
        <p class="text-primary/80 text-sm md:text-base font-sans">
          Notre priorité : conserver vos dents naturelles le plus longtemps possible et privilégier les
          traitements les moins invasifs. Sauf urgence, aucune intervention n'est engagée avant une analyse
          globale de votre dentition.
        </p>
        <p class="text-primary/80 text-sm md:text-base font-sans">
          La prévention est le soin le plus important : contrôle annuel, détartrage et conseils d'hygiène
          personnalisés, avec une hygiéniste dentaire dédiée. Pour garantir des délais raisonnables, nous
          limitons le nombre de nouveaux patients accueillis chaque semaine.
        </p>
      </div>
      <figure class="bg-white rounded-3xl p-7 md:p-9 flex flex-col gap-6" data-reveal-right>

        <!-- Guillemet décoratif + étoiles -->
        <div class="flex items-start justify-between">
          <svg width="40" height="30" viewBox="0 0 40 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0 30V18.75C0 13.75 1.25 9.58333 3.75 6.25C6.29167 2.91667 9.83333 0.833333 14.375 0L16.25 3.125C13.75 3.79167 11.6667 5.125 10 7.125C8.375 9.08333 7.5 11.25 7.375 13.625H15V30H0ZM23.75 30V18.75C23.75 13.75 25 9.58333 27.5 6.25C30.0417 2.91667 33.5833 0.833333 38.125 0L40 3.125C37.5 3.79167 35.4167 5.125 33.75 7.125C32.125 9.08333 31.25 11.25 31.125 13.625H38.75V30H23.75Z" fill="#D7B899"/>
          </svg>
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <Star class="w-4 h-4 text-quaternary" fill="currentColor" stroke="currentColor" stroke-width="0.5" />
            ))}
          </div>
        </div>

        <!-- Citation -->
        <blockquote class="text-primary/80 text-base md:text-lg font-sans leading-relaxed flex-1">
          Tout vous est expliqué jusqu'à l'efficacité de votre brossage quotidien sur base des clichés
          qu'il réalise ! Un praticien qui responsabilise ses patients dans le respect et la bienveillance.
        </blockquote>

        <!-- Auteur + logo Google -->
        <figcaption class="flex items-center justify-between gap-4 pt-5 border-t border-primary/10">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-tertiary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-quaternary font-bold text-sm">CW</span>
            </div>
            <div class="flex flex-col">
              <span class="text-primary font-semibold text-sm">Céline Wailliez</span>
              <span class="text-primary/50 text-xs font-sans">Avis publié sur Google</span>
            </div>
          </div>
          <!-- Logo Google -->
          <svg width="56" viewBox="0 0 272 92" xmlns="http://www.w3.org/2000/svg" aria-label="Google" class="opacity-35 flex-shrink-0">
            <path d="M115.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18C71.25 34.32 81.24 25 93.5 25s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44S80.99 39.2 80.99 47.18c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z" fill="#EA4335"/><path d="M163.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18c0-12.85 9.99-22.18 22.25-22.18s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44s-12.51 5.46-12.51 13.44c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z" fill="#FBBC05"/><path d="M209.75 26.34v39.82c0 16.38-9.66 23.07-21.08 23.07-10.75 0-17.22-7.19-19.66-13.07l8.48-3.53c1.51 3.61 5.21 7.87 11.17 7.87 7.31 0 11.84-4.51 11.84-13v-3.19h-.34c-2.18 2.69-6.38 5.04-11.68 5.04-11.09 0-21.25-9.66-21.25-22.09 0-12.52 10.16-22.26 21.25-22.26 5.29 0 9.49 2.35 11.68 4.96h.34v-3.61h9.25zm-8.56 20.92c0-7.81-5.21-13.52-11.84-13.52-6.72 0-12.35 5.71-12.35 13.52 0 7.73 5.63 13.36 12.35 13.36 6.63 0 11.84-5.63 11.84-13.36z" fill="#4285F4"/><path d="M225 3v65h-9.5V3h9.5z" fill="#34A853"/><path d="M262.02 54.48l7.56 5.04c-2.44 3.61-8.32 9.83-18.48 9.83-12.6 0-22.01-9.74-22.01-22.18 0-13.19 9.49-22.18 20.92-22.18 11.51 0 17.14 9.16 18.98 14.11l1.01 2.52-29.65 12.28c2.27 4.45 5.8 6.72 10.75 6.72 4.96 0 8.4-2.44 10.92-6.14zm-23.27-7.98l19.82-8.23c-1.09-2.77-4.37-4.7-8.23-4.7-4.95 0-11.84 4.37-11.59 12.93z" fill="#EA4335"/><path d="M35.29 41.41V32H67c.31 1.64.47 3.58.47 5.68 0 7.06-1.93 15.79-8.15 22.01-6.05 6.3-13.78 9.66-24.02 9.66C16.32 69.35.36 53.89.36 34.91.36 15.93 16.32.47 35.3.47c10.5 0 17.98 4.12 23.6 9.49l-6.64 6.64c-4.03-3.78-9.49-6.72-16.97-6.72-13.86 0-24.7 11.17-24.7 25.03 0 13.86 10.84 25.03 24.7 25.03 8.99 0 14.11-3.61 17.39-6.89 2.66-2.66 4.41-6.46 5.1-11.65l-22.49.01z" fill="#4285F4"/>
          </svg>
        </figcaption>

      </figure>
    </section>

    <!-- TOUS NOS SOINS v2 (gamme complète + maillage interne) -->
    <section class="w-full py-12 md:py-24 flex flex-col gap-8">
      <div class="flex flex-col gap-3 max-w-3xl">
        <span class="text-quaternary font-semibold text-sm md:text-base uppercase tracking-wide">Nos soins</span>
        <h2 class="text-primary font-bold text-2xl md:text-3xl lg:text-4xl" data-reveal-title>
          Tous vos soins dentaires, en un seul endroit
        </h2>
        <p class="text-primary/70 text-sm md:text-base font-sans">
          Des soins courants à l'expertise spécialisée, nous réunissons sous un même toit l'ensemble des
          disciplines — pour vous éviter de multiplier les interlocuteurs.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6" data-reveal-cards>
        {
          specialites.map((s) => (
            <div class="bg-white rounded-3xl p-6 md:p-7 flex flex-col gap-2 transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.06)]" data-reveal-card>
              <h3 class="text-primary font-semibold text-lg md:text-xl">{s.titre}</h3>
              <p class="text-primary/70 text-sm md:text-base font-sans">{s.texte}</p>
            </div>
          ))
        }
        <!-- Cellule CTA -> page services -->
        <div class="flex flex-col justify-center gap-4 px-2 py-4 md:px-4" data-reveal-card>
          <p class="text-primary/70 text-base md:text-lg font-sans">
            Découvrez l'ensemble des soins que nous pratiquons au cabinet.
          </p>
          <a
            href="/nos-services"
            class="inline-flex w-fit items-center gap-2 bg-primary text-white pl-5 pr-2.5 py-2.5 rounded-full font-semibold font-sans text-sm md:text-base hover:bg-primary/90 transition-all duration-300"
          >
            Nos services
            <span class="bg-white/15 rounded-full p-1.5">
              <ArrowUpRight class="w-4 h-4" />
            </span>
          </a>
        </div>
      </div>
    </section>

    <Tarification
      titleAccent="Cabinet déconventionné :"
      title=" ce que cela change pour votre remboursement"
      paragraphs={[
        "Nous l'assumons clairement : nos praticiens exercent en tant que dentistes déconventionnés. Être déconventionné nous offre la liberté d'utiliser les meilleures techniques et matériaux sans être limités par les contraintes de temps imposées par l'INAMI.",
        "Concrètement, votre mutuelle vous rembourse la base légale habituelle, et la différence d'honoraires reste à votre charge — ou à celle de votre assurance dentaire complémentaire si vous en avez une. Ce choix nous permet de consacrer le temps nécessaire à chaque patient, y compris aux bénéficiaires de l'intervention majorée (BIM).",
        "Aucun traitement n'est engagé sans une estimation d'honoraires précise au préalable : la transparence est notre priorité pour que vous décidiez en toute confiance.",
      ]}
    />
    <Testimonial />
    <Faq />
    <Location />

    <!-- BLOC AUTEUR v2 (EEAT) — composant réutilisable -->
    <AuthorBio imageData={imgJulien} />

    <BigCta />
    <Footer />
  </div>
</Layout>
