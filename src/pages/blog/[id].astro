---
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

const { id } = Astro.params;
// URL pour les appels API côté serveur
const DIRECTUS_URL = import.meta.env.DIRECTUS_URL || 'http://localhost:8055';
// URL publique pour les assets (images) côté client
const PUBLIC_DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://localhost:8055';

interface Badge {
  badges_id: {
    id: string;
    nom: string;
  };
}

interface BlogArticle {
  id: string;
  titre: string;
  description: string;
  contenu: string;
  auteur_nom: string;
  auteur_profession: string;
  photo_principale: {
    id: string;
    filename_disk: string;
  };
  avatar_auteur: {
    id: string;
    filename_disk: string;
  };
  date_created: string;
  status: string;
  temps_lecture: number | null;
  badges: Badge[];
}

let article: BlogArticle | null = null;

try {
  const response = await fetch(`${DIRECTUS_URL}/items/blog/${id}?fields=id,titre,description,contenu,auteur_nom,auteur_profession,photo_principale.id,photo_principale.filename_disk,avatar_auteur.id,avatar_auteur.filename_disk,date_created,status,temps_lecture,badges.badges_id.id,badges.badges_id.nom`);
  
  if (response.ok) {
    const data = await response.json();
    article = data.data;
    
    // Vérifier que l'article est publié
    if (article && article.status !== 'published') {
      article = null;
    }
  }
} catch (error) {
  console.error('Erreur lors de la récupération de l\'article:', error);
}

function formatDate(dateString: string) {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('fr-FR', { 
    day: 'numeric', 
    month: 'long', 
    year: 'numeric' 
  }).format(date);
}

// Si l'article n'existe pas ou n'est pas publié, retourner une 404
if (!article) {
  return Astro.redirect('/404');
}
---

<Layout title={`${article.titre} - La Dent du Géant`}>
  <div class="px-4 md:px-8 lg:px-10">
    <Header />
    
    <article class="max-w-4xl mx-auto py-16 lg:py-24">
      <!-- Image principale -->
      {article.photo_principale && (
        <div class="relative w-full h-96 lg:h-[500px] rounded-2xl overflow-hidden mb-8">
          <img
            src={`${PUBLIC_DIRECTUS_URL}/assets/${article.photo_principale.id}`}
            alt={article.titre}
            class="w-full h-full object-cover"
          />
        </div>
      )}
      
      <!-- En-tête de l'article -->
      <header class="mb-8">
        <h1 class="text-4xl lg:text-5xl font-bold text-primary mb-4">
          {article.titre}
        </h1>
        
        <p class="text-xl text-primary/70 mb-6">
          {article.description}
        </p>

        {/* Badges et temps de lecture */}
        {(article.badges && article.badges.length > 0) || article.temps_lecture ? (
          <div class="flex flex-wrap items-center gap-2 mb-6">
            {article.badges && article.badges.map((badge) => (
              <span class="bg-[#fafafa] border border-[#e9eaeb] px-3 py-1 rounded-full text-sm font-medium text-[#414651]">
                {badge.badges_id.nom}
              </span>
            ))}
            {article.temps_lecture && (
              <span class="text-sm font-medium text-[#3c3c3c] px-3 py-1">
                ⏱️ Temps de lecture : {article.temps_lecture} min
              </span>
            )}
          </div>
        ) : null}
        
        <!-- Informations sur l'auteur -->
        <div class="flex items-center gap-4 py-6 border-y border-primary/10">
          {article.avatar_auteur && (
            <img
              src={`${PUBLIC_DIRECTUS_URL}/assets/${article.avatar_auteur.id}`}
              alt={article.auteur_nom}
              class="w-16 h-16 rounded-full object-cover"
            />
          )}
          <div class="flex-1">
            <p class="font-semibold text-lg text-primary">
              {article.auteur_nom}
            </p>
            <p class="text-primary/60">
              {article.auteur_profession}
            </p>
          </div>
          <div class="text-right">
            <p class="text-sm text-primary/50">
              {formatDate(article.date_created)}
            </p>
          </div>
        </div>
      </header>
      
      <!-- Contenu de l'article -->
      <div 
        class="blog-content max-w-none"
        set:html={article.contenu}
      />
      
      <!-- Bouton retour -->
      <div class="mt-12 pt-8 border-t border-primary/10">
        <a 
          href="/blog" 
          class="inline-flex items-center gap-2 text-primary font-semibold hover:underline"
        >
          ← Retour au blog
        </a>
      </div>
    </article>
    
    <Footer />
  </div>
</Layout>
