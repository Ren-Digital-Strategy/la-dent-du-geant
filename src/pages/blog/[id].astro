---
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

const { id } = Astro.params;
// URL pour les appels API côté serveur
const DIRECTUS_URL = import.meta.env.DIRECTUS_URL || 'http://localhost:8055';
// URL publique pour les assets (images) côté client
const PUBLIC_DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://localhost:8055';

interface Badge {
  badges_id: {
    id: string;
    nom: string;
  };
}

interface BlogArticle {
  id: string;
  titre: string;
  description: string;
  contenu: string;
  auteur_nom: string;
  auteur_profession: string;
  photo_principale: {
    id: string;
    filename_disk: string;
  };
  avatar_auteur: {
    id: string;
    filename_disk: string;
  };
  date_created: string;
  status: string;
  temps_lecture: number | null;
  badges: Badge[];
}

export async function getStaticPaths() {
  const DIRECTUS_URL = import.meta.env.DIRECTUS_URL || "http://localhost:8055";
  try {
    const response = await fetch(
      `${DIRECTUS_URL}/items/blog?filter[status][_eq]=published&fields=id`
    );
    if (response.ok) {
      const data = await response.json();
      const articles = data.data || [];
      return articles.map((a: { id: string }) => ({ params: { id: a.id } }));
    }
  } catch (error) {
    console.error("Erreur lors de la récupération des articles:", error);
  }
  return [];
}

let article: BlogArticle | null = null;

try {
  const response = await fetch(`${DIRECTUS_URL}/items/blog/${id}?fields=id,titre,description,contenu,auteur_nom,auteur_profession,photo_principale.id,photo_principale.filename_disk,avatar_auteur.id,avatar_auteur.filename_disk,date_created,status,temps_lecture,badges.badges_id.id,badges.badges_id.nom`);
  
  if (response.ok) {
    const data = await response.json();
    article = data.data;
    
    // Vérifier que l'article est publié
    if (article && article.status !== 'published') {
      article = null;
    }
  }
} catch (error) {
  console.error('Erreur lors de la récupération de l\'article:', error);
}

function formatDate(dateString: string) {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('fr-FR', { 
    day: 'numeric', 
    month: 'long', 
    year: 'numeric' 
  }).format(date);
}

// Si l'article n'existe pas ou n'est pas publié, retourner une 404
if (!article) {
  return Astro.redirect('/404');
}

const pageUrl = encodeURIComponent(Astro.url.href);
const pageTitle = encodeURIComponent(article.titre);
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}`;
---

<Layout title={`${article.titre} - La Dent du Géant`}>
  <div class="px-4 md:px-8 lg:px-10">
    <Header />
    
    <article class="max-w-4xl mx-auto py-16 lg:py-24">
      <!-- Image principale -->
      {article.photo_principale && (
        <div class="relative w-full h-96 lg:h-[500px] rounded-2xl overflow-hidden mb-8" data-hero-image style="clip-path: inset(0 100% 0 0);">
          <img
            src={`${PUBLIC_DIRECTUS_URL}/assets/${article.photo_principale.id}`}
            alt={article.titre}
            class="w-full h-full object-cover"
          />
        </div>
      )}
      
      <!-- En-tête de l'article -->
      <header class="mb-8">
        <h1 class="text-4xl lg:text-5xl font-bold text-primary mb-4" data-hero-title style="clip-path: inset(0 0 100% 0); transform: translateY(100%);">
          {article.titre}
        </h1>
        
        <p class="text-xl text-primary/70 mb-6" data-hero-text style="clip-path: inset(0 0 100% 0); transform: translateY(100%);">
          {article.description}
        </p>

        {/* Badges et temps de lecture */}
        {(article.badges && article.badges.length > 0) || article.temps_lecture ? (
          <div class="flex flex-wrap items-center gap-2 mb-6">
            {article.badges && article.badges.map((badge) => (
              <span class="bg-[#fafafa] border border-[#e9eaeb] px-3 py-1 rounded-full text-sm font-medium text-[#414651]">
                {badge.badges_id.nom}
              </span>
            ))}
            {article.temps_lecture && (
              <span class="text-sm font-medium text-[#3c3c3c] px-3 py-1">
                ⏱️ Temps de lecture : {article.temps_lecture} min
              </span>
            )}
          </div>
        ) : null}
        
        <!-- Informations sur l'auteur -->
        <div class="flex items-center gap-4 py-6 border-y border-primary/10">
          {article.avatar_auteur && (
            <img
              src={`${PUBLIC_DIRECTUS_URL}/assets/${article.avatar_auteur.id}`}
              alt={article.auteur_nom}
              class="w-16 h-16 rounded-full object-cover"
            />
          )}
          <div class="flex-1">
            <p class="font-semibold text-lg text-primary">
              {article.auteur_nom}
            </p>
            <p class="text-primary/60">
              {article.auteur_profession}
            </p>
          </div>
          <div class="text-right">
            <p class="text-sm text-primary/50">
              {formatDate(article.date_created)}
            </p>
          </div>
        </div>
      </header>
      
      <!-- Contenu de l'article -->
      <div 
        class="blog-content max-w-none"
        set:html={article.contenu}
        data-reveal-section
      />
      
      <!-- Partage & Retour -->
      <div class="mt-12 pt-8 border-t border-primary/10 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-primary font-semibold hover:underline"
        >
          ← Retour au blog
        </a>

        <div class="flex items-center gap-3">
          <span class="text-sm text-primary/50 font-medium">Partager :</span>
          <a
            href={facebookShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Partager sur Facebook"
            class="inline-flex items-center gap-2 bg-primary hover:bg-quaternary text-secondary text-sm font-semibold px-4 py-2 rounded-full transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </a>
          <a
            href={linkedinShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Partager sur LinkedIn"
            class="inline-flex items-center gap-2 bg-primary hover:bg-quaternary text-secondary text-sm font-semibold px-4 py-2 rounded-full transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </article>
    
    <Footer />
  </div>
</Layout>
